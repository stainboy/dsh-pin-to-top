{
  "name": "dsh-pin-to-top",
  "version": "0.1.0",
  "description": "Pin and unpin the current DeepSeek Harness session from the conversation header.",
  "type": "module",
  "main": "client.js",
  "exports": {
    ".": "./client.js",
    "./client": "./client.js"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "client.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check client.js && node --test test/*.test.js",
    "test": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session",
    "pin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainboy/dsh-pin-to-top.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
